# Backend API and realtime runtime
DEPLOYMENT_VERSION=local
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_ROOM_NAME=local-dev-room
SARVAM_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# Local PostgreSQL persistence
PERSISTENCE_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_voice_agent_mvp
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_RETRY_ATTEMPTS=2
DATABASE_RETRY_BACKOFF_SECONDS=0.05
DATABASE_QUEUE_MAX_ITEMS=500
DATABASE_DRAIN_TIMEOUT_SECONDS=2

# Worker resilience
WORKER_ID=voice-worker-local
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_AFTER_SECONDS=60
WORKER_DRAIN_TIMEOUT_SECONDS=30
MAX_CALL_DURATION_SECONDS=1800
CALL_TIMEOUT_WARNING_SECONDS=15
WORKER_HEALTH_PORT=8081

# Business defaults for local calls
BUSINESS_NAME=our clinic
BUSINESS_TYPE=clinic
BUSINESS_SERVICES=dental cleaning,braces treatment,general consultation
RECEPTIONIST_TONE=warm, concise, respectful, and phone-friendly

# Optional booking and notification providers
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
FAST2SMS_API_KEY=
