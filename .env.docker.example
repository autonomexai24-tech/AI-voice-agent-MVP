# Copy this file to .env.docker for local Docker Compose.
# EasyPanel should set these as service-level environment variables instead.

# Container ports exposed on the host
DEPLOYMENT_VERSION=local
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# Container resource limits
POSTGRES_MEMORY_LIMIT=512m
POSTGRES_CPU_LIMIT=0.50
BACKEND_MEMORY_LIMIT=512m
BACKEND_CPU_LIMIT=0.75
WORKER_MEMORY_LIMIT=768m
WORKER_CPU_LIMIT=1.00
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_CPU_LIMIT=0.50

# PostgreSQL container
POSTGRES_DB=ai_voice_agent_mvp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend persistence
PERSISTENCE_ENABLED=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_RETRY_ATTEMPTS=2
DATABASE_RETRY_BACKOFF_SECONDS=0.05
DATABASE_QUEUE_MAX_ITEMS=500
DATABASE_DRAIN_TIMEOUT_SECONDS=2
DATABASE_STARTUP_RETRY_ATTEMPTS=30
DATABASE_STARTUP_RETRY_BACKOFF_SECONDS=2
INITIALIZE_DATABASE_ON_STARTUP=true

# Dedicated LiveKit worker resilience
WORKER_ID=voice-worker-1
WORKER_HEALTH_PORT=8081
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_STALE_AFTER_SECONDS=60
WORKER_DRAIN_TIMEOUT_SECONDS=30
WORKER_STOP_GRACE_PERIOD=35s
MAX_CALL_DURATION_SECONDS=1800
CALL_TIMEOUT_WARNING_SECONDS=15

# Frontend-to-backend networking
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_INTERNAL_API_BASE_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_API_TIMEOUT_MS=8000

# Runtime provider secrets
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=replace-me
LIVEKIT_API_SECRET=replace-me
LIVEKIT_ROOM_NAME=production-room
SARVAM_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# Business defaults
BUSINESS_NAME=our clinic
BUSINESS_TYPE=clinic
BUSINESS_SERVICES=dental cleaning,braces treatment,general consultation
RECEPTIONIST_TONE=warm, concise, respectful, and phone-friendly

# Optional booking and notification providers
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
FAST2SMS_API_KEY=
